# AWS (generate via IAM policy wizard in the app)
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_DEFAULT_REGION=us-east-1

# LLM providers — set whichever you use
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=                    # optional, only needed if using gemini provider
OPENAI_API_KEY=                    # optional, only needed if using openai provider

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/cloudcost